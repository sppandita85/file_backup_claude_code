{
  "source_dir": "~/Downloads",
  "dest_dir": "~/Library/CloudStorage/OneDrive-Personal/Downloads-Backup",
  "schedule_hour": 2,
  "schedule_minute": 0,
  "min_age_minutes": 5,
  "exclude_extensions": [".crdownload", ".part", ".download", ".tmp"],
  "dashboard_port": 7474,
  "db_path": "~/.local/share/downloadsbackup/history.db",
  "log_path": "~/.local/share/downloadsbackup/mover.log"
}
